{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "type": "stat",
      "title": "Предсказаний отправлено",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "options": {"colorMode": "background", "graphMode": "area"},
      "targets": [{"expr": "sum(ml_predictions_submitted_total)", "legendFormat": "всего"}]
    },
    {
      "type": "stat",
      "title": "Кредитов потрачено (бонус)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "options": {"colorMode": "background", "graphMode": "area"},
      "targets": [{"expr": "sum(ml_credits_spent_total{kind=\"bonus\"})", "legendFormat": "бонус"}]
    },
    {
      "type": "stat",
      "title": "Кредитов потрачено (платные)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "options": {"colorMode": "background", "graphMode": "area"},
      "targets": [{"expr": "sum(ml_credits_spent_total{kind=\"paid\"})", "legendFormat": "платные"}]
    },
    {
      "type": "stat",
      "title": "Rate limit блокировок",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "options": {"colorMode": "background"},
      "targets": [{"expr": "sum(ml_rate_limit_blocks_total) or vector(0)", "legendFormat": "блокировок"}]
    },
    {
      "type": "timeseries",
      "title": "Запросы в секунду по эндпоинтам",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 6},
      "targets": [
        {
          "expr": "sum by (handler) (rate(http_requests_total[1m]))",
          "legendFormat": "{{handler}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Предсказания в минуту",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 6},
      "targets": [
        {
          "expr": "rate(ml_predictions_submitted_total[1m]) * 60",
          "legendFormat": "предсказаний/мин"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP ответы по статусам",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Кредиты потрачены (rate)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "targets": [
        {
          "expr": "sum by (kind) (rate(ml_credits_spent_total[1m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["churn", "ml"],
  "time": {"from": "now-30m", "to": "now"},
  "title": "Churn Service Overview",
  "uid": "churn-main",
  "version": 1
}