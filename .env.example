# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=mluser
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=mlservice
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── JWT (ОБЯЗАТЕЛЬНО сменить!) ──────────────────────────────
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── Model ───────────────────────────────────────────────────
MODEL_PATH=models/churn_model.joblib

# ─── Tariffs ─────────────────────────────────────────────────
DEFAULT_RATE_LIMIT=60
DEFAULT_RATE_WINDOW=60
DEFAULT_MAX_CONCURRENT=5
PREDICTION_COST=1
SIGNUP_BONUS_CREDITS=20

# ─── Admin (создаётся при первом запуске) ────────────────────
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ─── Grafana ─────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ─── API ─────────────────────────────────────────────────────
API_URL=http://app:8000
